{
  "name": "shirabe-reader",
  "version": "0.3.0",
  "private": true,
  "description": "Parse Japanese on any web page and look it up with Shirabe.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs firefox",
    "build:firefox": "node build.mjs firefox",
    "build:chrome": "node build.mjs chrome",
    "watch:chrome": "node build.mjs chrome --watch",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node test/run.mjs",
    "verify:release": "node test/release-package.mjs",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "verify:build:firefox": "node build.mjs firefox --outdir=dist/verify/firefox",
    "verify:build:chrome": "node build.mjs chrome --outdir=dist/verify/chrome",
    "verify:installed:chrome": "node test/installed-parity.mjs",
    "verify:install:firefox": "node test/installed-firefox.mjs",
    "package:firefox": "node test/release-package.mjs firefox && web-ext build --source-dir dist/firefox --artifacts-dir artifacts/firefox --overwrite-dest --filename shirabe-reader-firefox.zip",
    "package:chrome": "node test/release-package.mjs chrome && web-ext build --source-dir dist/chrome --artifacts-dir artifacts/chrome --overwrite-dest --filename shirabe-reader-chrome.zip",
    "sdk:link": "node script/link-sdk.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.0",
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.4",
    "happy-dom": "^20.10.6",
    "playwright": "1.62.0",
    "tailwindcss": "4.3.0",
    "typescript": "^5.6.0",
    "web-ext": "^10.5.0",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "@shirabe-org/api": "0.6.1",
    "@shirabe-org/card": "0.2.1",
    "kanji-processor": "^1.0.2"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lostcoords/shirabe-reader.git"
  },
  "homepage": "https://shirabe.org",
  "bugs": {
    "url": "https://github.com/lostcoords/shirabe-reader/issues"
  },
  "engines": {
    "node": ">=24"
  }
}
