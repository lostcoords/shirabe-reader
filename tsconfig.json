{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // shirabe-sdk is a sibling project in this repo, not an installed package:
    // the extension bundles it from source (docs/plans/word-card-library.md).
    "baseUrl": ".",
    "paths": { "shirabe-sdk/*": ["../shirabe-sdk/src/*"] },
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": []
  },
  "include": ["src", "build.mjs"]
}
