// Type-checks the test suite, which the base config deliberately leaves out: it
// describes browser code, so it carries no node types and no node globals.
//
// dom.test.ts and click-positions.test.ts drive happy-dom, whose Element/Document
// types differ from lib.dom's. Both are bundled and executed by test/run.mjs;
// type-checking these harnesses needs a separate happy-dom typing strategy.
// Everything else is checked.
//
// all.test.ts goes with it: it is the import manifest the runner bundles, so
// including it would drag dom.test.ts back in through the import graph, where
// `exclude` cannot reach. It holds fourteen imports and no logic of its own.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src", "test"],
  "exclude": ["test/dom.test.ts", "test/click-positions.test.ts", "test/all.test.ts"]
}
