// Type-checks the test suite, which the base config deliberately leaves out: it
// describes browser code, so it carries no node types and no node globals.
//
// click-positions.test.ts drives happy-dom, whose Element/Document types differ
// from lib.dom's; it is bundled and executed by test/run.mjs but not checked.
// Everything else is checked.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src", "test"],
  "exclude": ["test/click-positions.test.ts"]
}
